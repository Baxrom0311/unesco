# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# android (android-app/)
android-app/local.properties
android-app/.gradle/
android-app/.idea/
android-app/*/build/
android-app/build/
android-app/captures/
android-app/*.iml
android-app/.externalNativeBuild/
android-app/.cxx/
android-app/*.apk
android-app/*.aab
android-app/*.jks
android-app/*.keystore
