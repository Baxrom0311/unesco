GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
# Per-process limits: deploy with ONE uvicorn worker.
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_ANALYSES=4
# Durable UTC daily model-attempt cap; includes failures. Not a dollar budget.
DAILY_MODEL_REQUEST_LIMIT=500
BUDGET_DB_PATH=data/usage.sqlite3
# Empty disables browser cross-origin calls; native Android is unaffected.
CORS_ORIGINS=
# Install ffmpeg (ffprobe) and libzbar for audio and QR support.
FFPROBE_PATH=ffprobe
