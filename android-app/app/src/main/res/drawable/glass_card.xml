<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glassFill" />
            <stroke android:width="1dp" android:color="@color/glassStroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/glassSheen"
                android:centerColor="#00FFFFFF"
                android:centerY="0.35"
                android:endColor="#00FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="26dp" android:right="26dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="@color/glassEdgeLight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
