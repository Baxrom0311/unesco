<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ishonasizmi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Boshqa ilovalardan (Telegram, Chrome va h.k.) "Ulashish" orqali matn qabul qilish -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Istalgan ilovada matn belgilanganda (select) chiqadigan
                 "qo'shimcha imkoniyatlar" panelida ilova sifatida ko'rinish -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Boshqa ilovalar ustida doim turadigan suzuvchi tugma xizmati -->
        <!-- Bosilganda alohida oyna OCHMAYDI — natija karta sifatida ustiga chiqadi -->

        <service
            android:name=".BubbleService"
            android:exported="false" />
    </application>
</manifest>
